/* CloudAgri Studio - Precision AgTech & Farm Twin Theme */
:root {
    --bg-main: #070e12;
    --bg-card: rgba(13, 23, 30, 0.75);
    --bg-card-hover: rgba(22, 38, 49, 0.85);
    --border: rgba(255, 255, 255, 0.08);
    --border-accent: rgba(16, 185, 129, 0.3);
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --emerald-primary: #10b981;
    --emerald-gradient: linear-gradient(135deg, #10b981 0%, #059669 50%, #047857 100%);
    --accent-lime: #84cc16;
    --accent-amber: #f59e0b;
    --accent-sky: #0ea5e9;
    --accent-purple: #8b5cf6;
    --accent-rose: #f43f5e;
    --radius-lg: 16px;
    --radius-md: 10px;
    --font: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: var(--font);
}

body {
    background-color: var(--bg-main);
    color: var(--text-primary);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    background-image: 
        radial-gradient(circle at 10% 15%, rgba(16, 185, 129, 0.08) 0%, transparent 45%),
        radial-gradient(circle at 90% 85%, rgba(14, 165, 233, 0.08) 0%, transparent 45%);
}

/* Header & Navigation */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(16px);
    background: rgba(7, 14, 18, 0.85);
    position: sticky;
    top: 0;
    z-index: 50;
}

.logo-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
}

.logo-badge {
    background: var(--emerald-gradient);
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    box-shadow: 0 0 25px rgba(16, 185, 129, 0.4);
}

.logo-text h1 {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(120deg, #ffffff, #a7f3d0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.logo-text span {
    font-size: 0.75rem;
    color: var(--accent-lime);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

nav {
    display: flex;
    gap: 0.4rem;
    align-items: center;
}

.nav-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.nav-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
}

.nav-btn.active {
    color: #fff;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.35);
}

/* Main Layout */
main {
    flex: 1;
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1.5rem;
}

.view-section {
    display: none;
    animation: fadeIn 0.3s ease-in-out forwards;
}

.view-section.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Glassmorphism Panel */
.glass-panel {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(14px);
    padding: 1.75rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
}

/* Telemetry Grid */
.telemetry-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.metric-card {
    background: rgba(13, 23, 30, 0.6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.metric-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-accent);
}

.metric-title {
    font-size: 0.78rem;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.05em;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.metric-value {
    font-size: 1.85rem;
    font-weight: 800;
    color: #fff;
    margin: 0.5rem 0 0.25rem;
}

.metric-sub {
    font-size: 0.78rem;
    color: var(--emerald-primary);
    font-weight: 500;
}

/* HUD Pill */
.hud-pill {
    background: rgba(13, 23, 30, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
}

.hud-pill.active {
    color: var(--emerald-primary);
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.12);
}

/* Primary Action Buttons */
.btn-primary {
    background: var(--emerald-gradient);
    color: #fff;
    border: none;
    border-radius: var(--radius-md);
    padding: 0.85rem 1.6rem;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 18px rgba(16, 185, 129, 0.35);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(16, 185, 129, 0.5);
}

.btn-secondary {
    background: rgba(255, 255, 255, 0.07);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.7rem 1.2rem;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
}

.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.14);
}

/* Farm Map Layout */
.farm-map-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
}

@media (max-width: 1024px) {
    .farm-map-container {
        grid-template-columns: 1fr;
    }
}

.map-wrapper {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    height: 480px;
    background: #091319;
}

.map-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.map-toolbar {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    gap: 0.5rem;
    background: rgba(7, 14, 18, 0.8);
    backdrop-filter: blur(8px);
    padding: 0.35rem;
    border-radius: 8px;
    border: 1px solid var(--border);
}

.map-tool-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.map-tool-btn.active {
    background: var(--emerald-primary);
    color: #070e12;
}

/* Zone Select Cards */
.zones-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    max-height: 480px;
    overflow-y: auto;
    padding-right: 0.25rem;
}

.zone-selector-card {
    background: rgba(13, 23, 30, 0.6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem;
    cursor: pointer;
    transition: all 0.2s;
    border-left: 4px solid var(--emerald-primary);
}

.zone-selector-card:hover {
    background: rgba(22, 38, 49, 0.7);
    border-color: rgba(255, 255, 255, 0.2);
}

.zone-selector-card.selected {
    background: rgba(16, 185, 129, 0.12);
    border-color: var(--emerald-primary);
    box-shadow: 0 0 16px rgba(16, 185, 129, 0.25);
}

/* Disease Vision Lab Layout */
.vision-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
}

@media (max-width: 960px) {
    .vision-grid {
        grid-template-columns: 1fr;
    }
}

.scanner-frame {
    position: relative;
    width: 100%;
    height: 380px;
    background: #091319;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
}

.scanner-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

/* Animated Scanner Laser Beam */
.scanner-laser {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, transparent, #10b981, #4ade80, transparent);
    box-shadow: 0 0 15px #10b981, 0 0 30px #4ade80;
    animation: scanLaser 2.2s infinite ease-in-out;
    pointer-events: none;
    opacity: 0;
}

.scanner-laser.scanning {
    opacity: 1;
}

@keyframes scanLaser {
    0% { top: 0%; }
    50% { top: 98%; }
    100% { top: 0%; }
}

/* Bounding Box on Lesions */
.lesion-box {
    position: absolute;
    border: 2px dashed #f59e0b;
    background: rgba(245, 158, 11, 0.2);
    border-radius: 4px;
    pointer-events: none;
    animation: boxPulse 1.5s infinite alternate;
}

@keyframes boxPulse {
    from { border-color: #f59e0b; }
    to { border-color: #ef4444; }
}

.lesion-tag {
    position: absolute;
    top: -18px;
    left: 0;
    background: #f59e0b;
    color: #000;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
}

/* Gallery Thumbnails */
.sample-gallery {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
    margin-top: 1rem;
}

.gallery-thumb {
    height: 65px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid var(--border);
    cursor: pointer;
    transition: all 0.2s;
    background: #091319;
}

.gallery-thumb:hover, .gallery-thumb.active {
    border-color: var(--emerald-primary);
    transform: scale(1.04);
}

.gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Metric Bars */
.bar-track {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    border-radius: 9999px;
    transition: width 0.8s ease-in-out;
}

.bar-fill.green { background: linear-gradient(90deg, #10b981, #84cc16); }
.bar-fill.amber { background: linear-gradient(90deg, #f59e0b, #ef4444); }
.bar-fill.sky { background: linear-gradient(90deg, #0ea5e9, #38bdf8); }
.bar-fill.purple { background: linear-gradient(90deg, #8b5cf6, #c084fc); }

/* FPV Drone HUD Overlay */
.fpv-hud-container {
    position: relative;
    width: 100%;
    height: 440px;
    background: #000;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(16, 185, 129, 0.4);
}

.fpv-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.1) brightness(0.95);
    transition: filter 0.3s;
}

.fpv-bg-img.thermal-flir {
    filter: invert(1) hue-rotate(180deg) saturate(3) contrast(1.4);
}

.fpv-crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    pointer-events: none;
}

.fpv-telemetry-overlay {
    position: absolute;
    inset: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
    font-family: 'Courier New', Courier, monospace;
}

.fpv-top-bar {
    display: flex;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.82rem;
    color: var(--accent-lime);
}

.fpv-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.82rem;
    color: var(--emerald-primary);
}

/* AgriCopilot Chat Drawer */
.chat-window {
    display: flex;
    flex-direction: column;
    height: 480px;
    background: rgba(13, 23, 30, 0.7);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    overflow: hidden;
}

.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}

.chat-bubble {
    max-width: 85%;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    font-size: 0.88rem;
    line-height: 1.5;
}

.chat-bubble.user {
    align-self: flex-end;
    background: var(--emerald-gradient);
    color: #fff;
    border-bottom-right-radius: 2px;
}

.chat-bubble.ai {
    align-self: flex-start;
    background: rgba(22, 38, 49, 0.9);
    color: #cbd5e1;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom-left-radius: 2px;
}

.chat-prompt-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: rgba(7, 14, 18, 0.8);
    border-top: 1px solid var(--border);
}

.chat-prompt-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.2s;
}

.chat-prompt-btn:hover {
    color: #fff;
    border-color: var(--emerald-primary);
    background: rgba(16, 185, 129, 0.15);
}

.chat-input-bar {
    display: flex;
    padding: 0.75rem 1rem;
    background: rgba(7, 14, 18, 0.95);
    border-top: 1px solid var(--border);
    gap: 0.6rem;
}

.chat-input {
    flex: 1;
    background: rgba(13, 23, 30, 0.8);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    color: #fff;
    font-size: 0.88rem;
    outline: none;
}

.chat-input:focus {
    border-color: var(--emerald-primary);
}

/* Robotics Fleet Grid */
.robot-card {
    background: rgba(13, 23, 30, 0.75);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.robot-card:hover {
    border-color: var(--emerald-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.2);
}

.robot-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
}

.robot-avatar {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}

/* Soil Stratigraphy Layers */
.soil-layer-strip {
    display: flex;
    flex-direction: column;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
}

.soil-stratum {
    padding: 0.85rem 1.15rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    transition: all 0.2s;
}

.soil-stratum:hover {
    filter: brightness(1.15);
}

.stratum-a { background: #3b2816; color: #fed7aa; } /* Topsoil */
.stratum-b { background: #573a21; color: #fdba74; } /* Subsoil */
.stratum-c { background: #291d12; color: #d6d3d1; } /* Bedrock/Deep */

/* Simulation Control Bar */
.sim-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(13, 23, 30, 0.8);
    border: 1px solid var(--border);
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
}

/* Table Utilities */
.data-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
}

.data-table th, .data-table td {
    padding: 0.85rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
}

.data-table th {
    color: var(--text-secondary);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
}

/* Print styling */
@media print {
    body { background: #fff !important; color: #000 !important; }
    header, nav, .sim-controls, .btn-primary, .btn-secondary { display: none !important; }
    .glass-panel { background: #fff !important; border: 1px solid #ccc !important; box-shadow: none !important; }
}
